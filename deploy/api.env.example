# api 容器环境变量 —— cp 成 deploy/api.env 后填值（凭据真源：根 .env 的 JSON 总账）
# 未配置的插件会降级 disabled（不报错）；GET /readyz 可查看实际生效的集成。
# 生产建议 STRICT_INTEGRATIONS=true 让缺失配置启动即失败。

# ---- 服务 ----
PORT=3000
LOG_LEVEL=info
STRICT_INTEGRATIONS=false

# ---- redis（检索缓存 / Streams 队列）；缺省则缓存禁用 ----
# 远程：redis://:密码@115.190.209.1:6380/0   ｜ 本地 infra profile：redis://:密码@redis:6379/0
REDIS_URL=

# ---- PostgreSQL（workflow 表 / 版本历史，drizzle）；缺省则工作流 CRUD 与登录 503 ----
# 远程需带 sslmode=no-verify（自签证书）：
# postgresql://user:密码@115.190.209.1:5433/myappdb?sslmode=no-verify
# 本地 infra profile：postgres://user:密码@postgres:5432/myappdb
DATABASE_URL=

# ---- Qdrant（向量库）----
# 远程：http://115.190.209.1:6333（明文 HTTP + token）｜ 本地：http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=

# ---- 检索集合清单（语法 name[@vectorName]，逗号分隔）----
# 带 @ = 命名向量集合（知识库原型）；不带 = apps/data 同步的 per-repo 集合
RAG_SEARCH_COLLECTIONS=knowledgeOfAI@text-embedding-v4,chinese-buy-us-stock-guide-main
# 检索响应缓存秒数，0 禁用（需 REDIS_URL）
RAG_CACHE_TTL=300

# ---- LLM / 嵌入（DashScope OpenAI 兼容端点）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 可观测（可选；三者配齐才启动 OTel SDK 上报 Langfuse）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
