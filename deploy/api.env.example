# api 容器环境变量 —— cp 成 deploy/api.env 后填值（凭据真源：根 .env 的 JSON 总账）
#
# ⚠️ 填写规则：**可选变量保持注释状态，不要写成 `KEY=` 留空**。
#    本服务对空字符串是容错的（插件会降级 disabled，不会崩，但 /readyz 里原因会显示成
#    "Invalid url" 而不是清晰的 "Required"）。需要 X 就取消注释再填值。
#    未配置的插件降级 disabled 是**预期态**；GET /readyz 可查看实际生效的集成。
#    生产建议 STRICT_INTEGRATIONS=true，让缺失配置启动即失败（实测会点名缺哪个变量）。

# ---- 服务 ----
PORT=3000
LOG_LEVEL=info
STRICT_INTEGRATIONS=false

# ---- redis（检索缓存）；不配则缓存禁用 ----
# REDIS_URL=redis://:密码@115.190.209.1:6380/0

# ---- PostgreSQL（workflow 表 / 版本历史）；不配则工作流 CRUD 与登录 503 ----
# 远程自签证书需 sslmode=no-verify；本地 infra profile 用 @postgres:5432
# DATABASE_URL=postgresql://user:密码@115.190.209.1:5433/myappdb?sslmode=no-verify

# ---- Qdrant（向量库）；不配则检索 503 ----
# QDRANT_URL=http://115.190.209.1:6333
# QDRANT_API_KEY=

# ---- LLM / 嵌入（DashScope OpenAI 兼容端点）；不配则检索 503 ----
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 检索集合清单（语法 name[@vectorName]，逗号分隔）----
# 带 @ = 命名向量集合（知识库原型）；不带 = apps/data 同步的 per-repo 集合
# 未创建的集合只会告警跳过；全部失败才 502
RAG_SEARCH_COLLECTIONS=knowledgeOfAI@text-embedding-v4,chinese-buy-us-stock-guide-main
# 检索响应缓存秒数，0 禁用（需 REDIS_URL）
RAG_CACHE_TTL=300

# ---- 可观测（可选；三者配齐才启动 OTel SDK 上报 Langfuse）----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
