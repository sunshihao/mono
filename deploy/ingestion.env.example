# ingestion 容器环境变量 —— cp 成 deploy/ingestion.env 后填值
#
# ⚠️ 填写规则（实测踩过）：**可选变量必须整行注释掉，不要写成 `KEY=` 留空**。
#    本服务的 env 走 zod fail-fast 校验，空字符串对 `z.string().url().optional()`
#    是「存在但非法」而不是「未配置」→ 容器直接 Exited(1) 崩溃（api 则只降级，不崩）。
#    需要 X 就把 `# X=...` 的注释去掉再填值；不需要就保持注释状态。

# ---- 服务 ----
PORT=3002
LOG_LEVEL=info

# ---- 文件监听（chokidar + 轮询兜底）----
# 容器内路径由 compose 固定为 /data/docs（与只读挂载目标一致），此处写了也会被覆盖
INGEST_DIR=/data/docs
POLL_INTERVAL_MS=60000

# ---- 统一写入的 Redis Stream（不配则 XADD 跳过，webhook 仍返回 202 信封）----
# REDIS_URL=redis://:密码@115.190.209.1:6380/0

# ---- 消费侧（三者齐备才启动；缺一不可，但**留空会崩**，所以整行注释）----
# QDRANT_URL=http://115.190.209.1:6333
# QDRANT_API_KEY=
# OPENAI_API_KEY=

# ---- 嵌入端点（有默认值，保持取消注释即可）----
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 切分参数（对齐 ../RAG 原型的 SentenceSplitter 512/50）----
INDEX_CHUNK_SIZE=512
INDEX_CHUNK_OVERLAP=50
