# ingestion 容器环境变量 —— cp 成 deploy/ingestion.env 后填值
# 注意：INGEST_DIR 由 compose 固定为 /data/docs（与只读挂载目标一致），此处写了也会被覆盖。

# ---- 服务 ----
PORT=3002
LOG_LEVEL=info

# ---- 文件监听（chokidar + 轮询兜底）；与挂载目录配套，容器内固定 /data/docs ----
INGEST_DIR=/data/docs
POLL_INTERVAL_MS=60000

# ---- 统一写入的 Redis Stream（缺省则 XADD 跳过，webhook 仍返回 202 信封）----
REDIS_URL=

# ---- 消费侧（REDIS_URL + QDRANT_URL + OPENAI_API_KEY 三者齐备才启动）----
QDRANT_URL=
QDRANT_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 切分参数（对齐 ../RAG 原型的 SentenceSplitter 512/50）----
INDEX_CHUNK_SIZE=512
INDEX_CHUNK_OVERLAP=50
