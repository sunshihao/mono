# compose 插值变量（本文件入库，**不得写真实凭据**）
#
# 为什么需要它：docker compose 默认会读项目根目录的 .env 做插值，而本仓根 .env 是
# JSON 凭据总账（不是 dotenv 格式），compose 会直接报
#   failed to read .../.env: line 1: unexpected character "{"
# 因此所有 compose 命令统一带 `--env-file deploy/compose.env`（或直接用根 package.json
# 的 docker:* 脚本），显式指定插值来源，绕开根 .env。
#
# 真实凭据放在各服务的 deploy/*.env（已 gitignore），经服务级 env_file 注入容器。
# 值都是公开信息（端口/域名/URL），写这里没有泄密风险。

# ---- 宿主发布端口（均只绑 127.0.0.1，对外只由 Caddy 出网）----
API_PORT=3000
WEB_PORT=3001
INGESTION_PORT=3002
DATA_PORT=3003

# ---- web 构建期 API 地址（改了必须重建 web 镜像）----
# 直连模式（本机自测）：浏览器直接访问 api 的发布端口
NEXT_PUBLIC_API_URL=http://localhost:3000
# 同源模式（生产）：改成 https://<域名>/api，并配合 --profile proxy + SITE_ADDRESS
# NEXT_PUBLIC_API_URL=https://rag.example.com/api

# ---- Caddy 站地址（--profile proxy 时生效）----
# localhost = Caddy 内部自签 CA（浏览器需信任）；真实域名 = 自动申请 Let's Encrypt
SITE_ADDRESS=localhost
# SITE_ADDRESS=rag.example.com

# ---- 宿主挂载路径 ----
INGEST_HOST_DIR=./deploy/ingest-docs
DATA_REPOS_DIR=./apps/data/repos
DATA_STATE_DIR=./apps/data/.sync-state
DATA_CONFIG_FILE=./apps/data/sync.config.yaml

# ---- local-infra profile 的容器内凭据（仅容器网络内使用，未发布任何端口）----
# 与 deploy/*.env 里的连接串保持一致即可；**不要把远程真实凭据写在这里**
POSTGRES_USER=myappuser
POSTGRES_PASSWORD=myapppass
POSTGRES_DB=myappdb
REDIS_PASSWORD=myapppass
