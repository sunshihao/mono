# data 容器环境变量 —— cp 成 deploy/data.env 后填值
# QDRANT_URL / OPENAI_API_KEY 不在本服务的 env 校验里，但被 sync.config.yaml 的
# env:VAR 引用——缺失会在配置加载阶段 fail-fast 报错，必须提供。

# ---- 服务 ----
PORT=3003
LOG_LEVEL=info

# ---- 配置与状态路径（相对进程 cwd=/app）----
DATA_CONFIG_PATH=sync.config.yaml
SYNC_STATE_DIR=.sync-state

# ---- redis（每仓库一条 Stream + 消费租约 + 重试 ZSET）；缺省则 worker/对账禁用、push 被拒 503 ----
REDIS_URL=

# ---- 向量库 / 嵌入（经 sync.config.yaml 的 env: 引用解析）----
QDRANT_URL=
QDRANT_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- worker / 对账调参 ----
WORKER_POLL_MS=1000
WORKER_LEASE_MS=600000
WORKER_MAX_RETRIES=5
RECONCILE_INTERVAL_MS=300000

# ---- 每个仓库的 GitHub webhook secret（与 GitHub 端配置一致；生成：openssl rand -hex 20）----
# 变量名取自 sync.config.yaml 各仓库的 webhook_secret_ref: env:<名字>
GH_WEBHOOK_SECRET_STOCK_GUIDE=

# 部署前置（容器内不做 git clone，须宿主机先检出，见 apps/data/README.md）：
#   git submodule add <repo-url> apps/data/repos/<name>
# 私有仓库拉取凭据（git fetch 在容器内执行）：
#   HTTPS → 在宿主机的 .git/config remote 里带 token，或挂载 credential 文件
#   SSH   → 挂载 deploy key 到 /root/.ssh（镜像已装 openssh-client）
