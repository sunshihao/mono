# data 容器环境变量 —— cp 成 deploy/data.env 后填值
#
# ⚠️ 填写规则（实测踩过）：**可选变量必须整行注释掉，不要写成 `KEY=` 留空**。
#    本服务 fail-fast：空字符串对 `z.string().url().optional()` 是「存在但非法」，
#    容器直接 Exited(1) 崩溃（compose 里 data 的 env_file 是 required:true，缺文件会
#    立刻报错，但**文件存在而值为空**仍会崩，所以务必按下面的规则填）。

# ---- 服务 ----
PORT=3003
LOG_LEVEL=info

# ---- 配置与状态路径（相对进程 cwd=/app）----
DATA_CONFIG_PATH=sync.config.yaml
SYNC_STATE_DIR=.sync-state

# ---- redis（每仓库一条 Stream + 消费租约 + 重试 ZSET）----
# 不配则 worker/对账禁用、push 被拒 503（进程正常运行）——**留空会崩，故整行注释**
# REDIS_URL=redis://:密码@115.190.209.1:6380/0

# ---- 向量库 / 嵌入：必填（sync.config.yaml 经 env: 引用，缺失即 fail-fast）----
QDRANT_URL=
QDRANT_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- worker / 对账调参 ----
WORKER_POLL_MS=1000
WORKER_LEASE_MS=600000
WORKER_MAX_RETRIES=5
RECONCILE_INTERVAL_MS=300000

# ---- 该仓库的 GitHub webhook secret：必填，否则该仓库的 push 会被拒 ----
# 变量名取自 sync.config.yaml 各仓库的 webhook_secret_ref: env:<名字>
# 生成：openssl rand -hex 20（并与 GitHub 端 Webhook 配置一致）
GH_WEBHOOK_SECRET_STOCK_GUIDE=

# 部署前置（容器内不做 git clone，须宿主机先检出，见 apps/data/README.md）：
#   git clone <repo-url> apps/data/repos/<name>
# 私有仓库拉取凭据（git fetch 在容器内执行）：
#   HTTPS → 在宿主机 clone 的 .git/config remote 里带 token（随 bind mount 进容器）
#   SSH   → 挂载 deploy key 到 /root/.ssh（镜像已装 openssh-client）
