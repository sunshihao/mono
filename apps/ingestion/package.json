        "chokidar": "^5.0.0",
        "hono": "^4.13.3",
        "ioredis": "^6.0.0",
        "pino": "^10.3.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
