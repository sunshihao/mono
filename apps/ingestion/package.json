{
    "name": "@repo/ingestion",
    "version": "0.1.0",
    "private": false,
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
