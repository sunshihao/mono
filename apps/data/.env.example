# 复用与 ingestion 相同的远端凭据（Qdrant / Redis / DashScope）
QDRANT_URL=
QDRANT_API_KEY=
REDIS_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# data 服务专属
PORT=3003
LOG_LEVEL=info
DATA_CONFIG_PATH=sync.config.yaml
SYNC_STATE_DIR=.sync-state
RECONCILE_INTERVAL_MS=300000
WORKER_LEASE_MS=60000
WORKER_MAX_RETRIES=5

# 每个仓库的 GitHub webhook secret（与 GitHub 端配置保持一致；生成：openssl rand -hex 20）
GH_WEBHOOK_SECRET_STOCK_GUIDE=
