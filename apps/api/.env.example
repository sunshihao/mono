# ---- 服务 ----
PORT=3000
LOG_LEVEL=info
# LOG_PRETTY=true            # 开发时打开 pino-pretty 彩色输出
STRICT_INTEGRATIONS=false    # true = 未配置的集成直接启动失败

# ---- redis（缓存 / PubSub / Streams 摄入队列）----
REDIS_URL=redis://localhost:6379

# ---- PostgreSQL（元数据 / 工作流版本，drizzle）----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ---- Qdrant（向量库，集合 knowledgeOfAI / 向量 text-embedding-v4）----
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Langfuse v5（OTel 可观测性）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- LLM（DashScope OpenAI 兼容端点，../RAG 原型同款：qwen-plus + text-embedding-v4）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
