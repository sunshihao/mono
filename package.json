{
    "name": "mono",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.2",
    "scripts": {
        "dev": "pnpm --filter @repo/types build && pnpm --parallel --filter @repo/api --filter @repo/ingestion dev",
        "dev:web": "pnpm --filter @repo/types build && pnpm --filter @repo/api build && pnpm --filter @repo/web dev",
        "build": "pnpm --filter @repo/types build && pnpm --filter @repo/api build && pnpm --filter @repo/ingestion build && pnpm --filter @repo/web build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm --filter @repo/types build && pnpm -r test",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.11"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "protobufjs",
            "tree-sitter"
        ]
    }
}
